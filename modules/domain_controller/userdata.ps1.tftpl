<powershell>
$ErrorActionPreference = "Stop"

###############################################################################
# Bootstrap launcher
#
# User data runs once and:
#   1. Writes the persistent bootstrap script locally.
#   2. Registers a SYSTEM scheduled task that runs after every restart.
#   3. Starts the bootstrap script immediately.
#
# The scheduled task removes itself after successful completion.
###############################################################################

$BootstrapDirectory = "C:\ProgramData\DomainControllerBootstrap"
$BootstrapScript    = Join-Path $BootstrapDirectory "Bootstrap.ps1"
$ScheduledTaskName  = "DomainControllerBootstrap"

New-Item `
    -Path $BootstrapDirectory `
    -ItemType Directory `
    -Force | Out-Null

$BootstrapContent = @'
$ErrorActionPreference = "Stop"

###############################################################################
# Configuration
###############################################################################

$LogDirectory   = "C:\ProgramData\DomainControllerBootstrap"
$LogFile        = Join-Path $LogDirectory "DomainControllerBootstrap.log"
$StageFile      = Join-Path $LogDirectory "Stage.txt"
$CompletionFile = Join-Path $LogDirectory "Complete.txt"
$FailureFile    = Join-Path $LogDirectory "Failure.txt"

$ScheduledTaskName = "DomainControllerBootstrap"

$TargetComputerName = "DC01"
$DomainName         = "${domain_name}"
$DomainNetbiosName  = "${domain_netbios_name}"
$FsxOuPath          = "${fsx_ou_distinguished_name}"
$ServiceAccountName = "${fsx_service_account_name}"

# Passwords are base64 encoded by Terraform so PowerShell-special characters
# in the original passwords do not corrupt the generated script.
$DomainAdministratorPassword = [System.Text.Encoding]::UTF8.GetString(
    [System.Convert]::FromBase64String(
        "${base64encode(domain_administrator_password)}"
    )
)

$FsxServiceAccountPassword = [System.Text.Encoding]::UTF8.GetString(
    [System.Convert]::FromBase64String(
        "${base64encode(fsx_service_account_password)}"
    )
)

New-Item `
    -Path $LogDirectory `
    -ItemType Directory `
    -Force | Out-Null

###############################################################################
# Logging and stage functions
###############################################################################

function Write-Log {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Message
    )

    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    Write-Output "[$Timestamp] $Message"
}

function Get-BootstrapStage {
    if (Test-Path $StageFile) {
        return (Get-Content -Path $StageFile -Raw).Trim()
    }

    return "Initial"
}

function Set-BootstrapStage {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Stage
    )

    Set-Content `
        -Path $StageFile `
        -Value $Stage `
        -Force

    Write-Log "Bootstrap stage set to: $Stage"
}

function Wait-ForActiveDirectory {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Domain,

        [int]$MaximumAttempts = 90,

        [int]$DelaySeconds = 20
    )

    Write-Log "Waiting for Active Directory domain $Domain."

    for ($Attempt = 1; $Attempt -le $MaximumAttempts; $Attempt++) {
        try {
            Import-Module ActiveDirectory -ErrorAction Stop

            $AdDomain = Get-ADDomain `
                -Identity $Domain `
                -ErrorAction Stop

            $RequiredServices = @(
                "DNS",
                "NTDS",
                "Netlogon",
                "KDC"
            )

            $UnavailableServices = @()

            foreach ($ServiceName in $RequiredServices) {
                $Service = Get-Service `
                    -Name $ServiceName `
                    -ErrorAction Stop

                if ($Service.Status -ne "Running") {
                    $UnavailableServices += (
                        "$ServiceName=$($Service.Status)"
                    )
                }
            }

            if ($UnavailableServices.Count -eq 0) {
                Write-Log (
                    "Active Directory is available. Domain: " +
                    $AdDomain.DNSRoot
                )

                return
            }

            Write-Log (
                "Attempt $Attempt of $MaximumAttempts. " +
                "Services not ready: " +
                ($UnavailableServices -join ", ")
            )
        }
        catch {
            Write-Log (
                "Attempt $Attempt of $MaximumAttempts failed: " +
                $_.Exception.Message
            )
        }

        Start-Sleep -Seconds $DelaySeconds
    }

    throw (
        "Active Directory did not become ready after " +
        "$MaximumAttempts attempts."
    )
}

function Test-AdDnsRecords {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Domain
    )

    $SrvRecord = "_ldap._tcp.dc._msdcs.$Domain"

    Write-Log "Registering Domain Controller DNS records."

    ipconfig /registerdns | Out-Null

    Restart-Service `
        -Name "Netlogon" `
        -Force `
        -ErrorAction Stop

    Start-Sleep -Seconds 10

    Write-Log "Checking DNS SRV record $SrvRecord locally."

    $Result = Resolve-DnsName `
        -Name $SrvRecord `
        -Type SRV `
        -Server "127.0.0.1" `
        -DnsOnly `
        -ErrorAction Stop

    if (-not $Result) {
        throw "No DNS SRV records were returned for $SrvRecord."
    }

    Write-Log "Active Directory DNS SRV record resolved successfully."
}

function Test-RequiredServices {
    $RequiredServices = @(
        "DNS",
        "NTDS",
        "Netlogon",
        "KDC"
    )

    foreach ($ServiceName in $RequiredServices) {
        $Service = Get-Service `
            -Name $ServiceName `
            -ErrorAction Stop

        if ($Service.Status -ne "Running") {
            throw (
                "Required service $ServiceName is not running. " +
                "Current status: $($Service.Status)"
            )
        }

        Write-Log (
            "Required service $ServiceName is running."
        )
    }
}

function Complete-Bootstrap {
    Set-Content `
        -Path $CompletionFile `
        -Value "Completed" `
        -Force

    Set-BootstrapStage -Stage "Completed"

    if (Test-Path $FailureFile) {
        Remove-Item `
            -Path $FailureFile `
            -Force `
            -ErrorAction SilentlyContinue
    }

    Write-Log "Domain controller bootstrap completed successfully."

    try {
        Unregister-ScheduledTask `
            -TaskName $ScheduledTaskName `
            -Confirm:$false `
            -ErrorAction Stop

        Write-Log "Bootstrap scheduled task removed."
    }
    catch {
        Write-Log (
            "The bootstrap completed, but the scheduled task could not " +
            "be removed: $($_.Exception.Message)"
        )
    }
}

###############################################################################
# Bootstrap execution
###############################################################################

try {
    Start-Transcript `
        -Path $LogFile `
        -Append `
        -ErrorAction Stop

    if (Test-Path $CompletionFile) {
        Write-Log "Domain controller bootstrap has already completed."

        try {
            Unregister-ScheduledTask `
                -TaskName $ScheduledTaskName `
                -Confirm:$false `
                -ErrorAction SilentlyContinue
        }
        catch {
            Write-Log "Scheduled task cleanup was not required."
        }

        exit 0
    }

    $CurrentStage = Get-BootstrapStage

    Write-Log "Current bootstrap stage: $CurrentStage"
    Write-Log "Current computer name: $env:COMPUTERNAME"
    Write-Log "Running as: $([System.Security.Principal.WindowsIdentity]::GetCurrent().Name)"

    # After a restart, allow Windows services and networking to settle before
    # continuing with the next stage.
    if ($CurrentStage -ne "Initial") {
        Write-Log "Post-restart execution detected. Waiting for Windows services."
        Start-Sleep -Seconds 30
    }

    ###########################################################################
    # Stage 1: Rename the server
    ###########################################################################

    if ($CurrentStage -eq "Initial") {
        if ($env:COMPUTERNAME -ne $TargetComputerName) {
            Write-Log (
                "Renaming computer from $env:COMPUTERNAME " +
                "to $TargetComputerName."
            )

            Set-BootstrapStage -Stage "ComputerRenamePending"

            Rename-Computer `
                -NewName $TargetComputerName `
                -Force `
                -ErrorAction Stop

            Write-Log "Computer rename requested. Restarting."

            Restart-Computer -Force
            exit 0
        }

        Write-Log "Computer already has the required name."

        Set-BootstrapStage -Stage "ComputerRenamed"
        $CurrentStage = "ComputerRenamed"
    }

    if ($CurrentStage -eq "ComputerRenamePending") {
        if ($env:COMPUTERNAME -ne $TargetComputerName) {
            throw (
                "Computer rename did not complete. Expected " +
                "$TargetComputerName but found $env:COMPUTERNAME."
            )
        }

        Write-Log "Computer rename completed successfully."

        Set-BootstrapStage -Stage "ComputerRenamed"
        $CurrentStage = "ComputerRenamed"
    }

    ###########################################################################
    # Stage 2: Install AD DS and create the forest
    ###########################################################################

    if ($CurrentStage -eq "ComputerRenamed") {
        Write-Log "Installing Active Directory Domain Services and DNS."

        $FeatureResult = Install-WindowsFeature `
            -Name "AD-Domain-Services", "DNS" `
            -IncludeManagementTools `
            -ErrorAction Stop

        if (-not $FeatureResult.Success) {
            throw "AD DS or DNS Windows feature installation failed."
        }

        Write-Log "AD DS and DNS Windows features installed."

        $SafeModePassword = ConvertTo-SecureString `
            $DomainAdministratorPassword `
            -AsPlainText `
            -Force

        Set-BootstrapStage -Stage "ForestInstallationPending"

        Write-Log "Creating Active Directory forest $DomainName."

        Install-ADDSForest `
            -DomainName $DomainName `
            -DomainNetbiosName $DomainNetbiosName `
            -SafeModeAdministratorPassword $SafeModePassword `
            -InstallDNS `
            -CreateDnsDelegation:$false `
            -DatabasePath "C:\Windows\NTDS" `
            -LogPath "C:\Windows\NTDS" `
            -SysvolPath "C:\Windows\SYSVOL" `
            -NoRebootOnCompletion:$false `
            -Force:$true `
            -ErrorAction Stop

        exit 0
    }

    ###########################################################################
    # Stage 3: Validate the forest after promotion
    ###########################################################################

    if ($CurrentStage -eq "ForestInstallationPending") {
        Write-Log "Validating Active Directory forest installation."

        Wait-ForActiveDirectory `
            -Domain $DomainName `
            -MaximumAttempts 90 `
            -DelaySeconds 20

        Test-RequiredServices
        Test-AdDnsRecords -Domain $DomainName

        $DomainController = Get-ADDomainController `
            -Discover `
            -DomainName $DomainName `
            -Writable `
            -Service GlobalCatalog `
            -ErrorAction Stop

        Write-Log (
            "Writable Global Catalog discovered: " +
            $DomainController.HostName
        )

        Set-BootstrapStage -Stage "DomainReady"
        $CurrentStage = "DomainReady"
    }

    ###########################################################################
    # Stage 4: Create the FSx OU and service account
    ###########################################################################

    if ($CurrentStage -eq "DomainReady") {
        Import-Module ActiveDirectory -ErrorAction Stop

        Write-Log "Checking FSx organisational unit: $FsxOuPath"

        $ExistingOu = $null

        try {
            $ExistingOu = Get-ADOrganizationalUnit `
                -Identity $FsxOuPath `
                -ErrorAction Stop
        }
        catch [Microsoft.ActiveDirectory.Management.ADIdentityNotFoundException] {
            $ExistingOu = $null
        }

        if (-not $ExistingOu) {
            $ParentDistinguishedName = (
                $FsxOuPath -replace "^OU=FSx,", ""
            )

            New-ADOrganizationalUnit `
                -Name "FSx" `
                -Path $ParentDistinguishedName `
                -ProtectedFromAccidentalDeletion $true `
                -ErrorAction Stop

            Write-Log "Created FSx organisational unit."
        }
        else {
            Write-Log "FSx organisational unit already exists."
        }

        #######################################################################
        # Create or update the FSx service account
        #######################################################################

        $SecureServiceAccountPassword = ConvertTo-SecureString `
            $FsxServiceAccountPassword `
            -AsPlainText `
            -Force

        $ExistingServiceAccount = Get-ADUser `
            -Filter "SamAccountName -eq '$ServiceAccountName'" `
            -ErrorAction SilentlyContinue

        if (-not $ExistingServiceAccount) {
            Write-Log "Creating FSx service account $ServiceAccountName."

            New-ADUser `
                -Name $ServiceAccountName `
                -SamAccountName $ServiceAccountName `
                -UserPrincipalName "$ServiceAccountName@$DomainName" `
                -AccountPassword $SecureServiceAccountPassword `
                -Enabled $true `
                -PasswordNeverExpires $true `
                -CannotChangePassword $false `
                -ErrorAction Stop

            Write-Log "FSx service account created."
        }
        else {
            Write-Log "Updating FSx service account $ServiceAccountName."

            Set-ADAccountPassword `
                -Identity $ExistingServiceAccount `
                -Reset `
                -NewPassword $SecureServiceAccountPassword `
                -ErrorAction Stop

            Enable-ADAccount `
                -Identity $ExistingServiceAccount `
                -ErrorAction Stop

            Set-ADUser `
                -Identity $ExistingServiceAccount `
                -PasswordNeverExpires $true `
                -ErrorAction Stop

            Write-Log "FSx service account updated."
        }

        #######################################################################
        # Delegate control of the FSx OU
        #######################################################################

        Write-Log "Delegating control of the FSx OU."

        # Reload the account in case it was just created.
        $ExistingServiceAccount = Get-ADUser `
            -Identity $ServiceAccountName `
            -ErrorAction Stop

        $ServiceAccountSid = $ExistingServiceAccount.SID

        $Ou = Get-ADOrganizationalUnit `
            -Identity $FsxOuPath `
            -ErrorAction Stop

        $OuEntry = New-Object `
            System.DirectoryServices.DirectoryEntry(
                "LDAP://$($Ou.DistinguishedName)"
            )

        try {
            $Acl = $OuEntry.ObjectSecurity

            $ActiveDirectoryRights = (
                [System.DirectoryServices.ActiveDirectoryRights]::GenericAll
            )

            $AccessControlType = (
                [System.Security.AccessControl.AccessControlType]::Allow
            )

            $InheritanceType = (
                [System.DirectoryServices.ActiveDirectorySecurityInheritance]::All
            )

            $Rule = New-Object `
                System.DirectoryServices.ActiveDirectoryAccessRule(
                    $ServiceAccountSid,
                    $ActiveDirectoryRights,
                    $AccessControlType,
                    $InheritanceType
                )

            $Acl.AddAccessRule($Rule)

            $OuEntry.ObjectSecurity = $Acl
            $OuEntry.CommitChanges()
        }
        finally {
            $OuEntry.Dispose()
        }

        Write-Log "FSx OU permissions delegated."

        Set-BootstrapStage -Stage "FsxConfigurationComplete"
        $CurrentStage = "FsxConfigurationComplete"
    }

    ###########################################################################
    # Stage 5: Final validation
    ###########################################################################

    if ($CurrentStage -eq "FsxConfigurationComplete") {
        Write-Log "Performing final Active Directory validation."

        Import-Module ActiveDirectory -ErrorAction Stop

        Test-RequiredServices

        Get-ADDomain `
            -Identity $DomainName `
            -ErrorAction Stop | Out-Null

        Get-ADOrganizationalUnit `
            -Identity $FsxOuPath `
            -ErrorAction Stop | Out-Null

        $ValidatedServiceAccount = Get-ADUser `
            -Identity $ServiceAccountName `
            -Properties Enabled `
            -ErrorAction Stop

        if (-not $ValidatedServiceAccount.Enabled) {
            throw "The FSx service account is not enabled."
        }

        Test-AdDnsRecords -Domain $DomainName

        $DomainController = Get-ADDomainController `
            -Discover `
            -DomainName $DomainName `
            -Writable `
            -Service GlobalCatalog `
            -ErrorAction Stop

        Write-Log (
            "Final validation located writable Global Catalog: " +
            $DomainController.HostName
        )

        Complete-Bootstrap
    }
}
catch {
    $ErrorMessage = $_.Exception.Message
    $ErrorDetails = $_ | Out-String

    Write-Log "DOMAIN CONTROLLER BOOTSTRAP FAILED: $ErrorMessage"
    Write-Output $ErrorDetails

    Set-Content `
        -Path $FailureFile `
        -Value $ErrorDetails `
        -Force

    throw
}
finally {
    try {
        Stop-Transcript
    }
    catch {
        Write-Output "Transcript was not running."
    }

    # Remove plaintext password variables from the current PowerShell process.
    $DomainAdministratorPassword = $null
    $FsxServiceAccountPassword   = $null
}
'@

Set-Content `
    -Path $BootstrapScript `
    -Value $BootstrapContent `
    -Encoding UTF8 `
    -Force

###############################################################################
# Register continuation task
###############################################################################

$TaskAction = New-ScheduledTaskAction `
    -Execute "PowerShell.exe" `
    -Argument (
        '-NoProfile -NonInteractive -ExecutionPolicy Bypass ' +
        '-File "C:\ProgramData\DomainControllerBootstrap\Bootstrap.ps1"'
    )

$TaskTrigger = New-ScheduledTaskTrigger -AtStartup

$TaskPrincipal = New-ScheduledTaskPrincipal `
    -UserId "SYSTEM" `
    -LogonType ServiceAccount `
    -RunLevel Highest

$TaskSettings = New-ScheduledTaskSettingsSet `
    -StartWhenAvailable `
    -ExecutionTimeLimit (New-TimeSpan -Hours 2) `
    -MultipleInstances IgnoreNew `
    -RestartCount 3 `
    -RestartInterval (New-TimeSpan -Minutes 1)

Register-ScheduledTask `
    -TaskName $ScheduledTaskName `
    -Action $TaskAction `
    -Trigger $TaskTrigger `
    -Principal $TaskPrincipal `
    -Settings $TaskSettings `
    -Description "Continues the staged Active Directory bootstrap after restarts." `
    -Force | Out-Null

###############################################################################
# Start first execution immediately
###############################################################################

Start-Process `
    -FilePath "PowerShell.exe" `
    -ArgumentList @(
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "`"$BootstrapScript`""
    ) `
    -WindowStyle Hidden
</powershell>