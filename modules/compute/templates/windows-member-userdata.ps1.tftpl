<powershell>

$ErrorActionPreference = "Stop"

$LogDirectory = "C:\ProgramData\Bootstrap"
$LogFile = "$LogDirectory\windows-member-bootstrap.log"
$FailureFile = "$LogDirectory\domain-join-failed.txt"
$StartedFile = "$LogDirectory\domain-join-started.txt"

New-Item `
    -Path $LogDirectory `
    -ItemType Directory `
    -Force | Out-Null

Start-Transcript -Path $LogFile -Append

try {
    Write-Output "Starting Windows member-server configuration"

    ###########################################################################
    # Make sure the AWS PowerShell module is available
    ###########################################################################

    $ModuleLoaded = $false

    for ($Attempt = 1; $Attempt -le 30; $Attempt++) {
        try {
            Import-Module AWSPowerShell -ErrorAction Stop

            $ModuleLoaded = $true

            Write-Output "AWSPowerShell module loaded"
            break
        }
        catch {
            Write-Output `
                "Waiting for AWSPowerShell module. Attempt $Attempt of 30"

            Start-Sleep -Seconds 10
        }
    }

    if (-not $ModuleLoaded) {
        throw "The AWSPowerShell module could not be loaded"
    }

    ###########################################################################
    # Identify the active network adapter
    ###########################################################################

    $NetworkAdapter = Get-NetAdapter |
        Where-Object {
            $_.Status -eq "Up" -and
            $_.HardwareInterface -eq $true
        } |
        Select-Object -First 1

    if (-not $NetworkAdapter) {
        throw "No active network adapter was found"
    }

    ###########################################################################
    # Point Windows DNS at the self-managed domain controller
    ###########################################################################

    Write-Output "Configuring Active Directory DNS servers"

    Set-DnsClientServerAddress `
        -InterfaceIndex $NetworkAdapter.ifIndex `
        -ServerAddresses @(
            "${primary_dns_server}",
            "${secondary_dns_server}"
        )

    Clear-DnsClientCache

    Write-Output "Configured DNS servers:"

    Get-DnsClientServerAddress `
        -InterfaceIndex $NetworkAdapter.ifIndex |
        Format-List

    ###########################################################################
    # Wait for Active Directory DNS to become available
    ###########################################################################

    $DomainAvailable = $false

    for ($Attempt = 1; $Attempt -le 30; $Attempt++) {
        try {
            Resolve-DnsName `
                -Name "_ldap._tcp.dc._msdcs.${domain_name}" `
                -Type SRV `
                -ErrorAction Stop

            $DomainAvailable = $true

            Write-Output "Active Directory DNS records are available"
            break
        }
        catch {
            Write-Output `
                "Waiting for Active Directory DNS. Attempt $Attempt of 30"

            Start-Sleep -Seconds 20
        }
    }

    if (-not $DomainAvailable) {
        throw "Unable to resolve the Active Directory DNS service record"
    }

    ###########################################################################
    # Retrieve the Domain Administrator credentials from Secrets Manager
    ###########################################################################

    Write-Output "Retrieving the domain-join secret"

    $SecretValue = Get-SECSecretValue `
        -SecretId "${domain_join_secret_arn}" `
        -Region "${aws_region}"

    if (-not $SecretValue.SecretString) {
        throw "The domain-join secret did not contain a SecretString value"
    }

    $DomainCredentials = $SecretValue.SecretString |
        ConvertFrom-Json

    if (-not $DomainCredentials.username) {
        throw "The domain-join secret does not contain a username"
    }

    if (-not $DomainCredentials.password) {
        throw "The domain-join secret does not contain a password"
    }

    $SecurePassword = ConvertTo-SecureString `
        $DomainCredentials.password `
        -AsPlainText `
        -Force

    $Credential = New-Object `
        System.Management.Automation.PSCredential(
            $DomainCredentials.username,
            $SecurePassword
        )

    ###########################################################################
    # Check whether the server is already domain joined
    ###########################################################################

    $ComputerSystem = Get-CimInstance Win32_ComputerSystem

    if (
        $ComputerSystem.PartOfDomain -and
        $ComputerSystem.Domain -ieq "${domain_name}"
    ) {
        Write-Output "The server is already joined to ${domain_name}"

        Set-Content `
            -Path "$LogDirectory\domain-join-complete.txt" `
            -Value "The server is joined to ${domain_name}"

        exit 0
    }

    ###########################################################################
    # Join the domain
    ###########################################################################

    $AddComputerParameters = @{
        DomainName = "${domain_name}"
        Credential = $Credential
        NewName     = "${computer_name}"
        Force       = $true
        Restart     = $true
        ErrorAction = "Stop"
    }

    if ("${domain_ou_path}" -ne "") {
        $AddComputerParameters["OUPath"] = "${domain_ou_path}"
    }

    Write-Output `
        "Joining ${computer_name} to the ${domain_name} domain"

    Set-Content `
        -Path $StartedFile `
        -Value "Domain join started for ${computer_name}"

    Add-Computer @AddComputerParameters
}
catch {
    $ErrorDetails = $_.Exception.ToString()

    Write-Error `
        "Windows member-server configuration failed: $ErrorDetails"

    Set-Content `
        -Path $FailureFile `
        -Value $ErrorDetails

    exit 1
}
finally {
    Stop-Transcript
}

</powershell>